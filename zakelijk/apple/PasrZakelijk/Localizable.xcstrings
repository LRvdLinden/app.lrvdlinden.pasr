    "Afkoeltijd: zo lang moet een klant wachten voor de volgende stempel. Bij scannen kies je zelf het aantal stempels, tot het maximum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cooldown: how long a customer has to wait for the next stamp. When scanning you choose the number of stamps yourself, up to the maximum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afkoeltijd: zo lang moet een klant wachten voor de volgende stempel. Bij scannen kies je zelf het aantal stempels, tot het maximum."
          }
        }
      }
    },
    "Alleen de laatste actie bij deze klant kan ongedaan worden gemaakt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the latest action for this customer can be undone."
