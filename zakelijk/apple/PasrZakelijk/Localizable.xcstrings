    "1. Scan de QR-code met de camera van je telefoon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Scan the QR code with your phone's camera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Scan de QR-code met de camera van je telefoon."
          }
        }
      }
    },
    "2. Bewaar de kaart in de gratis app Pasr, of gebruik hem in je browser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Save the card in the free Pasr app, or use it in your browser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Bewaar de kaart in de gratis app Pasr, of gebruik hem in je browser."
          }
        }
      }
    },
    "3. Laat bij elke aankoop je kaart scannen voor een stempel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Have your card scanned with every purchase to get a stamp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
