    },
    "De naam en plaats komen op je stempelkaart. Pasr kijkt je aanmelding na; daarna kun je kaarten publiceren en stempels zetten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name and city appear on your stamp card. Pasr reviews your sign-up; after that you can publish cards and add stamps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam en plaats komen op je stempelkaart. Pasr kijkt je aanmelding na; daarna kun je kaarten publiceren en stempels zetten."
          }
        }
      }
    },
