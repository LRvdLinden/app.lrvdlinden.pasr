    },
    "Als er een account is met dit adres, krijg je een mail met een link om een nieuw wachtwoord te kiezen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there is an account with this address, you'll receive an email with a link to choose a new password."
