    "De kaart is nog niet vol. Inwisselen kan pas bij een volle kaart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card isn't full yet. You can only redeem a full card."
          }
        },
