    "Alleen gratis tickets. Klanten melden zich aan via de link of QR-code en krijgen hun ticket in Pasr en Wallet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free tickets only. Customers register via the link or QR code and get their ticket in Pasr and Wallet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gratis tickets. Klanten melden zich aan via de link of QR-code en krijgen hun ticket in Pasr en Wallet."
