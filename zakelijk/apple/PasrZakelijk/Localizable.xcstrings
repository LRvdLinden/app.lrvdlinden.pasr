    "Bij aanmelden vragen we voornaam, achternaam, e-mailadres en geboortedatum (verplicht). Op het ticket staat alleen de naam; de QR-code bevat geen persoonsgegevens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When registering we ask for first name, last name, email address and date of birth (required). The ticket only shows the name; the QR code contains no personal data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij aanmelden vragen we voornaam, achternaam, e-mailadres en geboortedatum (verplicht). Op het ticket staat alleen de naam; de QR-code bevat geen persoonsgegevens."
          }
        }
      }
    },
