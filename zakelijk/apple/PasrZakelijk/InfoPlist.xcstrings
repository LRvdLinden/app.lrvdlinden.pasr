    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasr Zakelijk uses the camera to scan your customers' stamp cards, tickets, loyalty cards, coupons and codes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasr Zakelijk gebruikt de camera om stempelkaarten, tickets, klantenkaarten, kortingsbonnen en codes van je klanten te scannen."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasr Zakelijk uses Face ID to lock the app, so only you can add stamps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasr Zakelijk gebruikt Face ID om de app te vergrendelen, zodat alleen jij stempels kunt zetten."
          }
        }
      }
    }
  },
  "version": "1.0"
