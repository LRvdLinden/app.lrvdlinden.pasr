            "value": "Kaart toevoegen"
          }
        }
      }
    },
    "Add cards in Pasr on your iPhone. They appear here through iCloud.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg kaarten toe in Pasr op je iPhone. Ze verschijnen hier via iCloud."
