        }
      }
    },
    "Add loyalty cards and vouchers. They sync through your own iCloud and also appear on your Apple Watch.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg klantenkaarten en vouchers toe. Ze synchroniseren via je eigen iCloud en staan ook op je Apple Watch."
