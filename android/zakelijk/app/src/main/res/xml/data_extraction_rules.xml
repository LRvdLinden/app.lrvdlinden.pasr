<?xml version="1.0" encoding="utf-8"?>
<!-- De inlogsessie staat versleuteld met een sleutel van dit toestel: niet back-uppen of overzetten. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
