<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Alleen bij de winkel vragen (opt-in): je plek één keer opvragen bij het sluiten van een kaart, nooit bewaard of verstuurd -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PasrApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pasr.Starting">

        <receiver android:name=".notify.NearbyGeofenceReceiver" android:exported="false" />
        <receiver android:name=".FrequentCardsWidget" android:exported="false" android:label="Meest gebruikte Pasr-kaarten">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/pasr_widget_frequent" />
        </receiver>
        <receiver android:name=".FavoriteCardsWidget" android:exported="false" android:label="Favoriete Pasr-kaarten">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/pasr_widget_favorites" />
        </receiver>
        <!-- Snelle instellingen: tegel "Pasr-kaart" (Android-tegenhanger van Apple Wallet) -->
        <service
            android:name=".CardTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_card"
            android:label="Pasr-kaart"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/pasr_shortcuts" />
            <!-- App Links: gedeelde kaarten en stempelkaarten van zaken (assetlinks.json op pasr.nl) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="pasr.nl" />
                <data android:host="www.pasr.nl" />
                <data android:pathPrefix="/kaart" />
                <data android:pathPrefix="/tijdelijk" />
                <data android:pathPrefix="/zakelijk/kaart" />
                <data android:pathPrefix="/add/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pasr" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Pushmeldingen (Firebase Cloud Messaging): nieuws over je kaarten en stempels van zaken -->
        <service
            android:name=".notify.PasrMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="news" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_card" />

        <!-- Aankopen vanzelf vastleggen (opt-in, standaard uit): alleen betaalmeldingen, alleen op het toestel -->
        <service
            android:name=".notify.PaymentListener"
            android:exported="true"
            android:label="@string/payment_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".notify.PayActionReceiver"
            android:exported="false" />

        <!-- Bonnetjes delen als PDF of afbeelding (tijdelijke bestanden in de cache) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Tekstherkenning voor bonnetjes: het model van Google Play-services alvast op het toestel zetten -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- ML Kit barcode-scanning (gebundeld model): geen download via Google Play nodig -->
    </application>
</manifest>
