# BEGIN pasr
# Always HTTPS and without www
RewriteEngine On
# Retired preview: redirect to the corresponding production URL.
RewriteRule ^test/?$ / [R=301,L]
RewriteRule ^test/(.*)$ /$1 [R=301,L]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://pasr.nl%{REQUEST_URI} [L,R=301]

# No .html in addresses: /support.html and /support/index.html go to /support/
RewriteCond %{THE_REQUEST} \s/+(.+?)(?:/index)?\.html[\s?] [NC]
RewriteRule ^ /%1/ [L,R=301]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(png|jpg|svg|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Universal links: Apple fetches this file without an extension and expects JSON
<Files "apple-app-site-association">
  ForceType application/json
</Files>
# Android: APK's als download, altijd de nieuwste (niet cachen); assetlinks.json als JSON (App Links)
AddType application/vnd.android.package-archive .apk
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Cache-Control "no-cache"
    Header set Content-Disposition "attachment"
  </FilesMatch>
  <FilesMatch "^(pasr|pasr-zakelijk)\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<Files "assetlinks.json">
  ForceType application/json
</Files>
# Lijst van de deploy (alle bestanden op de site): alleen voor de upload via FTP, niet via het web
<Files "deploy-manifest.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
# END pasr
